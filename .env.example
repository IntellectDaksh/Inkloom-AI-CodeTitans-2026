# ==============================================================================
# Inkloom AI - Environment Configuration Template
# Copy this file to .env.local for local development.
# Do NOT commit actual secrets or credentials to source control.
# ==============================================================================

# AI Layer: Google Gemini API Key (Required for live contextual analysis)
# Also required to read PDFs and images in /api/extract (txt/md/json/csv/html/rtf/docx work without it).
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Supabase PostgreSQL & Auth Credentials
# When set, Inkloom synchronizes with your remote Supabase instance.
# When omitted, Inkloom uses its self-contained persistent store automatically.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=production
